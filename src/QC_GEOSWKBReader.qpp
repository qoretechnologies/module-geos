#include "QC_GEOSWKBReader.h"
#include "QC_GEOSGeometry.h"

//! WKB (Well-Known Binary) reader for parsing geometry binary data
/** @par Example:
    @code{.py}
GEOSWKBReader reader();
GEOSGeometry geom = reader.read(wkb_data);
    @endcode

    @since geos 1.0
*/
qclass GEOSWKBReader [arg=QoreGEOSWKBReader* r; ns=Qore::GEOS];

//! Creates a new WKB reader
/**
*/
GEOSWKBReader::constructor() {
    self->setPrivate(CID_GEOSWKBREADER, new QoreGEOSWKBReader());
}

//! Reads WKB binary data and returns a GEOSGeometry object
/** @param wkb the Well-Known Binary data to parse
    @return a new GEOSGeometry object

    @throw GEOS-ERROR error parsing WKB data
*/
GEOSGeometry GEOSWKBReader::read(binary wkb) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSGeometry* geom = GEOSWKBReader_read_r(ctx, r->getReader(),
        static_cast<const unsigned char*>(wkb->getPtr()), wkb->size());
    if (!geom) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "WKBReader::read")) {
            xsink->raiseException("GEOS-ERROR", "failed to parse WKB data");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(geom));
}

//! Reads a hex-encoded WKB string and returns a GEOSGeometry object
/** @param hex the hex-encoded WKB string to parse
    @return a new GEOSGeometry object

    @throw GEOS-ERROR error parsing hex WKB string
*/
GEOSGeometry GEOSWKBReader::readHEX(string hex) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSGeometry* geom = GEOSWKBReader_readHEX_r(ctx, r->getReader(),
        reinterpret_cast<const unsigned char*>(hex->c_str()), hex->strlen());
    if (!geom) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "WKBReader::readHEX")) {
            xsink->raiseException("GEOS-ERROR", "failed to parse hex WKB string");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(geom));
}
