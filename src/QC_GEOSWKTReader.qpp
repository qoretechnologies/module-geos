#include "QC_GEOSWKTReader.h"
#include "QC_GEOSGeometry.h"

//! WKT (Well-Known Text) reader for parsing geometry strings
/** @par Example:
    @code{.py}
GEOSWKTReader reader();
GEOSGeometry geom = reader.read("POINT (1.0 2.0)");
    @endcode

    @since geos 1.0
*/
qclass GEOSWKTReader [arg=QoreGEOSWKTReader* r; ns=Qore::GEOS];

//! Creates a new WKT reader
/**
*/
GEOSWKTReader::constructor() {
    self->setPrivate(CID_GEOSWKTREADER, new QoreGEOSWKTReader());
}

//! Reads a WKT string and returns a GEOSGeometry object
/** @param wkt the Well-Known Text string to parse
    @return a new GEOSGeometry object

    @throw GEOS-ERROR error parsing WKT string
*/
GEOSGeometry GEOSWKTReader::read(string wkt) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSGeometry* geom = GEOSWKTReader_read_r(ctx, r->getReader(), wkt->c_str());
    if (!geom) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "WKTReader::read")) {
            xsink->raiseException("GEOS-ERROR", "failed to parse WKT string");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(geom));
}
