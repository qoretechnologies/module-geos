#include "QC_GEOSWKBWriter.h"
#include "QC_GEOSGeometry.h"

//! WKB (Well-Known Binary) writer for serializing geometries to binary data
/** @par Example:
    @code{.py}
GEOSWKBWriter writer();
writer.setIncludeSRID(True);
binary wkb = writer.write(geom);
    @endcode

*/
qclass GEOSWKBWriter [arg=QoreGEOSWKBWriter* w; ns=Qore::GEOS];

//! Creates a new WKB writer
/**
*/
GEOSWKBWriter::constructor() {
    self->setPrivate(CID_GEOSWKBWRITER, new QoreGEOSWKBWriter());
}

//! Writes a geometry to WKB binary data
/** @param geom the geometry to serialize
    @return the WKB binary data

    @throw GEOS-ERROR error writing WKB
*/
binary GEOSWKBWriter::write(GEOSGeometry[QoreGEOSGeometry] geom) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    size_t size;
    unsigned char* wkb = GEOSWKBWriter_write_r(ctx, w->getWriter(), geom->getGeometry(), &size);
    if (!wkb) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "WKBWriter::write")) {
            xsink->raiseException("GEOS-ERROR", "error writing WKB");
        }
        return QoreValue();
    }
    BinaryNode* rv = new BinaryNode;
    rv->append(wkb, size);
    GEOSFree_r(ctx, wkb);
    return rv;
}

//! Writes a geometry to a hex-encoded WKB string
/** @param geom the geometry to serialize
    @return the hex-encoded WKB string

    @throw GEOS-ERROR error writing hex WKB
*/
string GEOSWKBWriter::writeHEX(GEOSGeometry[QoreGEOSGeometry] geom) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    size_t size;
    unsigned char* hex = GEOSWKBWriter_writeHEX_r(ctx, w->getWriter(), geom->getGeometry(), &size);
    if (!hex) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "WKBWriter::writeHEX")) {
            xsink->raiseException("GEOS-ERROR", "error writing hex WKB");
        }
        return QoreValue();
    }
    QoreStringNode* rv = new QoreStringNode(reinterpret_cast<const char*>(hex), size);
    GEOSFree_r(ctx, hex);
    return rv;
}

//! Sets the byte order for WKB output
/** @param order 0 for big-endian (XDR), 1 for little-endian (NDR)
*/
nothing GEOSWKBWriter::setByteOrder(int order) {
    GEOSWKBWriter_setByteOrder_r(geos_get_context(), w->getWriter(), order);
}

//! Sets the output dimension (2 or 3)
/** @param dim the output dimension
*/
nothing GEOSWKBWriter::setOutputDimension(int dim) {
    GEOSWKBWriter_setOutputDimension_r(geos_get_context(), w->getWriter(), dim);
}

//! Sets whether to include the SRID in the output
/** @param includeSRID @ref True to include the SRID
*/
nothing GEOSWKBWriter::setIncludeSRID(bool includeSRID) {
    GEOSWKBWriter_setIncludeSRID_r(geos_get_context(), w->getWriter(), includeSRID ? 1 : 0);
}
