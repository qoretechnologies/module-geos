#include "QC_GEOSGeoJSONWriter.h"
#include "QC_GEOSGeometry.h"

//! GeoJSON writer for serializing geometries to GeoJSON strings
/** @par Example:
    @code{.py}
GEOSGeoJSONWriter writer();
string json = writer.write(geom, 2); # pretty-printed with 2-space indent
    @endcode

    @note Writing GeoJSON Feature or FeatureCollection is not supported; only
    geometry objects are written.

*/
qclass GEOSGeoJSONWriter [arg=QoreGEOSGeoJSONWriter* w; ns=Qore::GEOS];

//! Creates a new GeoJSON writer
/**
*/
GEOSGeoJSONWriter::constructor() {
    self->setPrivate(CID_GEOSGEOJSONWRITER, new QoreGEOSGeoJSONWriter());
}

//! Writes a geometry to a GeoJSON string
/** @param geom the geometry to serialize
    @param indent the number of spaces for indentation (-1 for compact output)
    @return the GeoJSON string

    @throw GEOS-ERROR error writing GeoJSON
*/
string GEOSGeoJSONWriter::write(GEOSGeometry[QoreGEOSGeometry] geom, int indent = -1) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    char* json = GEOSGeoJSONWriter_writeGeometry_r(ctx, w->getWriter(), geom->getGeometry(), indent);
    if (!json) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "GeoJSONWriter::write")) {
            xsink->raiseException("GEOS-ERROR", "error writing GeoJSON");
        }
        return QoreValue();
    }
    QoreStringNode* rv = new QoreStringNode(json);
    GEOSFree_r(ctx, json);
    return rv;
}

//! Sets the output dimension (2 or 3)
/** @param dim the output dimension (2 for 2D, 3 for 3D)
*/
nothing GEOSGeoJSONWriter::setOutputDimension(int dim) {
#if GEOS_VERSION_MAJOR > 3 || (GEOS_VERSION_MAJOR == 3 && GEOS_VERSION_MINOR >= 12)
    GEOSGeoJSONWriter_setOutputDimension_r(geos_get_context(), w->getWriter(), dim);
#else
    xsink->raiseException("GEOS-ERROR", "setOutputDimension() requires GEOS >= 3.12 (installed: " GEOS_VERSION ")");
#endif
}

//! Returns the current output dimension
/** @return the output dimension (2 or 3)
*/
int GEOSGeoJSONWriter::getOutputDimension() [flags=RET_VALUE_ONLY] {
#if GEOS_VERSION_MAJOR > 3 || (GEOS_VERSION_MAJOR == 3 && GEOS_VERSION_MINOR >= 12)
    return GEOSGeoJSONWriter_getOutputDimension_r(geos_get_context(), w->getWriter());
#else
    xsink->raiseException("GEOS-ERROR", "getOutputDimension() requires GEOS >= 3.12 (installed: " GEOS_VERSION ")");
    return QoreValue();
#endif
}
