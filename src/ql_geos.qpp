#include "geos-module.h"
#include "QC_GEOSGeometry.h"
#include "QC_GEOSGeoJSONReader.h"
#include "QC_GEOSGeoJSONWriter.h"

#include <cstdlib>
#include <vector>
#include <climits>

//! Coordinate hash structure
/** Represents a single coordinate with X, Y, and optional Z components.

*/
hashdecl GEOSCoordinate {
    //! X coordinate
    float x;
    //! Y coordinate
    float y;
    //! Z coordinate (optional, for 3D geometries)
    *float z;
}

//! GEOS version information hash
/** Contains parsed version information for the GEOS library.

*/
hashdecl GEOSVersionInfo {
    //! Full version string (e.g., "3.12.0")
    string version;
    //! Major version number
    int major;
    //! Minor version number
    int minor;
    //! Patch version number
    int patch;
}

//! Geometry extent (bounding box) hash structure
/** Represents the axis-aligned bounding box of a geometry with minimum and maximum X/Y coordinates.

*/
hashdecl GEOSExtent {
    //! Minimum X coordinate
    float xmin;
    //! Minimum Y coordinate
    float ymin;
    //! Maximum X coordinate
    float xmax;
    //! Maximum Y coordinate
    float ymax;
}

/** @defgroup geos_geometry_type_constants Geometry Type Constants
    Integer constants identifying geometry types, as returned by
    @ref Qore::GEOS::GEOSGeometry::geometryTypeId() "GEOSGeometry::geometryTypeId()".

*/
///@{
namespace Qore::GEOS;

//! Point geometry type (0)
const GEOS_POINT = GEOS_POINT;
//! LineString geometry type (1)
const GEOS_LINESTRING = GEOS_LINESTRING;
//! LinearRing geometry type (2)
const GEOS_LINEARRING = GEOS_LINEARRING;
//! Polygon geometry type (3)
const GEOS_POLYGON = GEOS_POLYGON;
//! MultiPoint geometry type (4)
const GEOS_MULTIPOINT = GEOS_MULTIPOINT;
//! MultiLineString geometry type (5)
const GEOS_MULTILINESTRING = GEOS_MULTILINESTRING;
//! MultiPolygon geometry type (6)
const GEOS_MULTIPOLYGON = GEOS_MULTIPOLYGON;
//! GeometryCollection geometry type (7)
const GEOS_GEOMETRYCOLLECTION = GEOS_GEOMETRYCOLLECTION;
///@}

/** @defgroup geos_make_valid_constants MakeValid Method Constants
    Integer constants for geometry repair methods, used with
    @ref Qore::GEOS::GEOSGeometry::makeValidWithParams() "GEOSGeometry::makeValidWithParams()".

*/
///@{
namespace Qore::GEOS;

//! Linework method: combines all rings into noded lines and extracts valid polygons (0)
const GEOS_MAKE_VALID_LINEWORK = GEOS_MAKE_VALID_LINEWORK;
//! Structure method: makes rings valid then merges shells and subtracts holes (1)
const GEOS_MAKE_VALID_STRUCTURE = GEOS_MAKE_VALID_STRUCTURE;
///@}

/** @defgroup geos_buffer_style_constants Buffer Style Constants
    Constants for controlling buffer cap and join styles, used with
    @ref Qore::GEOS::GEOSGeometry::bufferWithStyle() "GEOSGeometry::bufferWithStyle()" and
    @ref Qore::GEOS::GEOSGeometry::offsetCurve() "GEOSGeometry::offsetCurve()".

*/
///@{
namespace Qore::GEOS;

//! Round end cap style (1)
const GEOSBUF_CAP_ROUND = GEOSBUF_CAP_ROUND;
//! Flat end cap style (2)
const GEOSBUF_CAP_FLAT = GEOSBUF_CAP_FLAT;
//! Square end cap style (3)
const GEOSBUF_CAP_SQUARE = GEOSBUF_CAP_SQUARE;
//! Round join style (1)
const GEOSBUF_JOIN_ROUND = GEOSBUF_JOIN_ROUND;
//! Mitre join style (2)
const GEOSBUF_JOIN_MITRE = GEOSBUF_JOIN_MITRE;
//! Bevel join style (3)
const GEOSBUF_JOIN_BEVEL = GEOSBUF_JOIN_BEVEL;
///@}

/** @defgroup geos_functions GEOS Functions
    Standalone functions for working with GEOS geometries.
 */
///@{
namespace Qore::GEOS;

//! Returns the GEOS library version string
/** @return the version string (e.g., "3.12.0-CAPI-1.18.0")

    @par Example:
    @code{.py}
string v = geos_version();
    @endcode

*/
string geos_version() [flags=CONSTANT] {
    return new QoreStringNode(GEOSversion());
}

//! Returns detailed GEOS version information
/** @return a @ref GEOSVersionInfo hash with parsed version components

    @par Example:
    @code{.py}
hash<GEOSVersionInfo> info = get_geos_info();
printf("GEOS %d.%d.%d\n", info.major, info.minor, info.patch);
    @endcode

*/
hash<GEOSVersionInfo> get_geos_info() [flags=RET_VALUE_ONLY] {
    const char* ver = GEOSversion();
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(hashdeclGEOSVersionInfo, xsink), xsink);
    h->setKeyValue("version", new QoreStringNode(ver), xsink);

    // parse "major.minor.patch" from the version string
    int major = 0, minor = 0, patch = 0;
    if (ver) {
        major = atoi(ver);
        const char* p = strchr(ver, '.');
        if (p) {
            minor = atoi(p + 1);
            p = strchr(p + 1, '.');
            if (p) {
                patch = atoi(p + 1);
            }
        }
    }
    h->setKeyValue("major", major, xsink);
    h->setKeyValue("minor", minor, xsink);
    h->setKeyValue("patch", patch, xsink);
    return h.release();
}

//! Convenience function to parse a WKT string into a GEOSGeometry
/** @param wkt the Well-Known Text string
    @return a new GEOSGeometry object

    @par Example:
    @code{.py}
GEOSGeometry geom = parse_wkt("POINT (1.0 2.0)");
    @endcode

    @throw GEOS-ERROR error parsing WKT string

*/
GEOSGeometry parse_wkt(string wkt) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSWKTReader* reader = GEOSWKTReader_create_r(ctx);
    if (!reader) {
        xsink->raiseException("GEOS-ERROR", "failed to create WKT reader");
        return QoreValue();
    }
    GEOSGeometry* geom = GEOSWKTReader_read_r(ctx, reader, wkt->c_str());
    GEOSWKTReader_destroy_r(ctx, reader);
    if (!geom) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "parse_wkt")) {
            xsink->raiseException("GEOS-ERROR", "failed to parse WKT string");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(geom));
}

//! Convenience function to serialize a GEOSGeometry to a WKT string
/** @param geom the geometry to serialize
    @return the WKT string

    @par Example:
    @code{.py}
string wkt = make_wkt(geom);
    @endcode

    @throw GEOS-ERROR error writing WKT

*/
string make_wkt(GEOSGeometry[QoreGEOSGeometry] geom) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSWKTWriter* writer = GEOSWKTWriter_create_r(ctx);
    if (!writer) {
        xsink->raiseException("GEOS-ERROR", "failed to create WKT writer");
        return QoreValue();
    }
    GEOSWKTWriter_setTrim_r(ctx, writer, 1);
    char* wkt = GEOSWKTWriter_write_r(ctx, writer, geom->getGeometry());
    GEOSWKTWriter_destroy_r(ctx, writer);
    if (!wkt) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "make_wkt")) {
            xsink->raiseException("GEOS-ERROR", "error writing WKT");
        }
        return QoreValue();
    }
    QoreStringNode* rv = new QoreStringNode(wkt);
    GEOSFree_r(ctx, wkt);
    return rv;
}

//! Convenience function to parse WKB binary data into a GEOSGeometry
/** @param wkb the Well-Known Binary data
    @return a new GEOSGeometry object

    @par Example:
    @code{.py}
GEOSGeometry geom = parse_wkb(wkb_data);
    @endcode

    @throw GEOS-ERROR error parsing WKB data

*/
GEOSGeometry parse_wkb(binary wkb) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSWKBReader* reader = GEOSWKBReader_create_r(ctx);
    if (!reader) {
        xsink->raiseException("GEOS-ERROR", "failed to create WKB reader");
        return QoreValue();
    }
    GEOSGeometry* geom = GEOSWKBReader_read_r(ctx, reader,
        static_cast<const unsigned char*>(wkb->getPtr()), wkb->size());
    GEOSWKBReader_destroy_r(ctx, reader);
    if (!geom) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "parse_wkb")) {
            xsink->raiseException("GEOS-ERROR", "failed to parse WKB data");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(geom));
}

//! Convenience function to serialize a GEOSGeometry to WKB binary data
/** @param geom the geometry to serialize
    @return the WKB binary data

    @par Example:
    @code{.py}
binary wkb = make_wkb(geom);
    @endcode

    @throw GEOS-ERROR error writing WKB

*/
binary make_wkb(GEOSGeometry[QoreGEOSGeometry] geom) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSWKBWriter* writer = GEOSWKBWriter_create_r(ctx);
    if (!writer) {
        xsink->raiseException("GEOS-ERROR", "failed to create WKB writer");
        return QoreValue();
    }
    size_t size;
    unsigned char* wkb = GEOSWKBWriter_write_r(ctx, writer, geom->getGeometry(), &size);
    GEOSWKBWriter_destroy_r(ctx, writer);
    if (!wkb) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "make_wkb")) {
            xsink->raiseException("GEOS-ERROR", "error writing WKB");
        }
        return QoreValue();
    }
    BinaryNode* rv = new BinaryNode;
    rv->append(wkb, size);
    GEOSFree_r(ctx, wkb);
    return rv;
}

//! Creates a 2D Point geometry from X and Y coordinates
/** @param x the X coordinate
    @param y the Y coordinate
    @return a new GEOSGeometry point

    @par Example:
    @code{.py}
GEOSGeometry pt = geos_create_point(1.0, 2.0);
    @endcode

    @throw GEOS-ERROR error creating point

*/
GEOSGeometry geos_create_point(float x, float y) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSGeometry* geom = GEOSGeom_createPointFromXY_r(ctx, x, y);
    if (!geom) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "geos_create_point")) {
            xsink->raiseException("GEOS-ERROR", "failed to create point");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(geom));
}

//! Creates a 3D Point geometry from X, Y, and Z coordinates
/** @param x the X coordinate
    @param y the Y coordinate
    @param z the Z coordinate
    @return a new GEOSGeometry point with Z coordinate

    @par Example:
    @code{.py}
GEOSGeometry pt3d = geos_create_point(1.0, 2.0, 3.0);
    @endcode

    @throw GEOS-ERROR error creating point

*/
GEOSGeometry geos_create_point(float x, float y, float z) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSCoordSequence* cs = GEOSCoordSeq_create_r(ctx, 1, 3);
    if (!cs) {
        xsink->raiseException("GEOS-ERROR", "failed to create coordinate sequence");
        return QoreValue();
    }
    GEOSCoordSeq_setXYZ_r(ctx, cs, 0, x, y, z);
    GEOSGeometry* geom = GEOSGeom_createPoint_r(ctx, cs);
    if (!geom) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "geos_create_point")) {
            xsink->raiseException("GEOS-ERROR", "failed to create 3D point");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(geom));
}

//! Creates a LineString geometry from a list of coordinates
/** @param coords a list of hashes with \c "x", \c "y", and optional \c "z" keys (at least 2 coordinates required)
    @return a new GEOSGeometry linestring

    @par Example:
    @code{.py}
GEOSGeometry line = geos_create_linestring((
    {"x": 0.0, "y": 0.0},
    {"x": 10.0, "y": 10.0},
    {"x": 20.0, "y": 25.0},
));
    @endcode

    @throw GEOS-ERROR error creating linestring or fewer than 2 coordinates

*/
GEOSGeometry geos_create_linestring(list coords) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSCoordSequence* cs = qore_list_to_coordseq(ctx, coords, xsink);
    if (!cs) {
        return QoreValue();
    }
    GEOSGeometry* geom = GEOSGeom_createLineString_r(ctx, cs);
    if (!geom) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "geos_create_linestring")) {
            xsink->raiseException("GEOS-ERROR", "failed to create linestring");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(geom));
}

//! Creates a Polygon geometry from exterior and optional interior (hole) coordinate rings
/** @param exterior a list of hashes with \c "x", \c "y", and optional \c "z" keys for the exterior ring
           (must be closed: first == last)
    @param holes an optional list of coordinate ring lists for interior holes
    @return a new GEOSGeometry polygon

    @par Example:
    @code{.py}
# simple polygon
list<hash<GEOSCoordinate>> ring = (
    {"x": 0, "y": 0}, {"x": 10, "y": 0}, {"x": 10, "y": 10},
    {"x": 0, "y": 10}, {"x": 0, "y": 0},
);
GEOSGeometry poly = geos_create_polygon(ring);

# polygon with a hole
list<hash<GEOSCoordinate>> hole = (
    {"x": 2, "y": 2}, {"x": 2, "y": 4}, {"x": 4, "y": 4},
    {"x": 4, "y": 2}, {"x": 2, "y": 2},
);
GEOSGeometry poly_with_hole = geos_create_polygon(ring, (hole,));
    @endcode

    @throw GEOS-ERROR error creating polygon or invalid ring

*/
GEOSGeometry geos_create_polygon(list exterior, *list holes) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();

    // create exterior ring
    GEOSCoordSequence* ext_cs = qore_list_to_coordseq(ctx, exterior, xsink);
    if (!ext_cs) {
        return QoreValue();
    }
    GEOSGeometry* shell = GEOSGeom_createLinearRing_r(ctx, ext_cs);
    if (!shell) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "geos_create_polygon")) {
            xsink->raiseException("GEOS-ERROR", "failed to create exterior ring");
        }
        return QoreValue();
    }

    // create interior rings (holes)
    size_t nholes = 0;
    GEOSGeometry** hole_geoms = nullptr;
    if (holes && holes->size() > 0) {
        nholes = holes->size();
        hole_geoms = new GEOSGeometry*[nholes];
        for (size_t i = 0; i < nholes; ++i) {
            const QoreListNode* hole_coords = holes->retrieveEntry(i).get<const QoreListNode>();
            if (!hole_coords) {
                // cleanup
                for (size_t j = 0; j < i; ++j) {
                    GEOSGeom_destroy_r(ctx, hole_geoms[j]);
                }
                delete[] hole_geoms;
                GEOSGeom_destroy_r(ctx, shell);
                xsink->raiseException("GEOS-ERROR", "hole %zu is not a coordinate list", i);
                return QoreValue();
            }
            GEOSCoordSequence* hole_cs = qore_list_to_coordseq(ctx, hole_coords, xsink);
            if (!hole_cs) {
                for (size_t j = 0; j < i; ++j) {
                    GEOSGeom_destroy_r(ctx, hole_geoms[j]);
                }
                delete[] hole_geoms;
                GEOSGeom_destroy_r(ctx, shell);
                return QoreValue();
            }
            hole_geoms[i] = GEOSGeom_createLinearRing_r(ctx, hole_cs);
            if (!hole_geoms[i]) {
                for (size_t j = 0; j < i; ++j) {
                    GEOSGeom_destroy_r(ctx, hole_geoms[j]);
                }
                delete[] hole_geoms;
                GEOSGeom_destroy_r(ctx, shell);
                if (!check_geos_error(xsink, "GEOS-ERROR", "geos_create_polygon")) {
                    xsink->raiseException("GEOS-ERROR", "failed to create interior ring %zu", i);
                }
                return QoreValue();
            }
        }
    }

    GEOSGeometry* geom = GEOSGeom_createPolygon_r(ctx, shell, hole_geoms, nholes);
    delete[] hole_geoms;
    if (!geom) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "geos_create_polygon")) {
            xsink->raiseException("GEOS-ERROR", "failed to create polygon");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(geom));
}

//! Creates a geometry collection from a list of geometries
/** @param geoms a list of GEOSGeometry objects
    @param type the collection type ID (e.g., @ref GEOS_MULTIPOINT, @ref GEOS_MULTILINESTRING,
           @ref GEOS_MULTIPOLYGON, @ref GEOS_GEOMETRYCOLLECTION)
    @return a new GEOSGeometry collection

    @par Example:
    @code{.py}
GEOSGeometry mp = geos_create_collection(
    (parse_wkt("POINT (0 0)"), parse_wkt("POINT (1 1)")),
    GEOS_MULTIPOINT);
    @endcode

    @throw GEOS-ERROR error creating collection or invalid type

*/
GEOSGeometry geos_create_collection(list geoms, int type) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();

    size_t ngeoms = geoms->size();
    // clone each geometry since GEOSGeom_createCollection_r takes ownership
    GEOSGeometry** geos_geoms = new GEOSGeometry*[ngeoms];
    for (size_t i = 0; i < ngeoms; ++i) {
        if (!(i % 100) && qore_check_cancel(xsink)) {
            for (size_t j = 0; j < i; ++j) {
                GEOSGeom_destroy_r(ctx, geos_geoms[j]);
            }
            delete[] geos_geoms;
            return QoreValue();
        }
        QoreObject* obj = geoms->retrieveEntry(i).get<QoreObject>();
        QoreGEOSGeometry* qg = static_cast<QoreGEOSGeometry*>(
            obj->getReferencedPrivateData(CID_GEOSGEOMETRY, xsink));
        if (!qg) {
            for (size_t j = 0; j < i; ++j) {
                GEOSGeom_destroy_r(ctx, geos_geoms[j]);
            }
            delete[] geos_geoms;
            if (!*xsink) {
                xsink->raiseException("GEOS-ERROR", "element %zu is not a GEOSGeometry", i);
            }
            return QoreValue();
        }
        geos_geoms[i] = GEOSGeom_clone_r(ctx, qg->getGeometry());
        qg->deref(xsink);
        if (!geos_geoms[i]) {
            for (size_t j = 0; j < i; ++j) {
                GEOSGeom_destroy_r(ctx, geos_geoms[j]);
            }
            delete[] geos_geoms;
            xsink->raiseException("GEOS-ERROR", "failed to clone geometry %zu", i);
            return QoreValue();
        }
    }

    GEOSGeometry* geom = GEOSGeom_createCollection_r(ctx, type, geos_geoms, ngeoms);
    delete[] geos_geoms;
    if (!geom) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "geos_create_collection")) {
            xsink->raiseException("GEOS-ERROR", "failed to create collection");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(geom));
}

//! Creates an empty geometry collection of the given type
/** @param type the collection type ID (e.g., @ref GEOS_MULTIPOINT, @ref GEOS_GEOMETRYCOLLECTION)
    @return a new empty GEOSGeometry collection

    @par Example:
    @code{.py}
GEOSGeometry empty = geos_create_empty_collection(GEOS_MULTIPOINT);
assertTrue(empty.isEmpty());
    @endcode

    @throw GEOS-ERROR error creating empty collection

*/
GEOSGeometry geos_create_empty_collection(int type) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSGeometry* geom = GEOSGeom_createEmptyCollection_r(ctx, type);
    if (!geom) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "geos_create_empty_collection")) {
            xsink->raiseException("GEOS-ERROR", "failed to create empty collection");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(geom));
}

//! Tests whether a DE-9IM intersection matrix matches a pattern
/** @param matrix the 9-character DE-9IM intersection matrix string
    @param pattern the pattern to match against (may contain wildcards: T, F, *, 0-9)
    @return @ref True if the matrix matches the pattern

    @par Example:
    @code{.py}
string matrix = geom1.relate(geom2);
bool is_within = geos_relate_pattern_match(matrix, "T*F**F***");
    @endcode

    @throw GEOS-ERROR error matching pattern

*/
bool geos_relate_pattern_match(string matrix, string pattern) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    char rv = GEOSRelatePatternMatch_r(ctx, matrix->c_str(), pattern->c_str());
    if (rv == 2) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "geos_relate_pattern_match")) {
            xsink->raiseException("GEOS-ERROR", "error matching DE-9IM pattern");
        }
        return QoreValue();
    }
    return (bool)rv;
}

//! Convenience function to parse a GeoJSON string into a GEOSGeometry
/** @param geojson the GeoJSON string
    @return a new GEOSGeometry object

    @par Example:
    @code{.py}
GEOSGeometry geom = parse_geojson('{"type": "Point", "coordinates": [1.0, 2.0]}');
    @endcode

    @throw GEOS-ERROR error parsing GeoJSON string

*/
GEOSGeometry parse_geojson(string geojson) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSGeoJSONReader* reader = GEOSGeoJSONReader_create_r(ctx);
    if (!reader) {
        xsink->raiseException("GEOS-ERROR", "failed to create GeoJSON reader");
        return QoreValue();
    }
    GEOSGeometry* geom = GEOSGeoJSONReader_readGeometry_r(ctx, reader, geojson->c_str());
    GEOSGeoJSONReader_destroy_r(ctx, reader);
    if (!geom) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "parse_geojson")) {
            xsink->raiseException("GEOS-ERROR", "failed to parse GeoJSON string");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(geom));
}

//! Convenience function to serialize a GEOSGeometry to a GeoJSON string
/** @param geom the geometry to serialize
    @param indent the number of spaces for indentation (-1 for compact output, default)
    @return the GeoJSON string

    @par Example:
    @code{.py}
string json = make_geojson(geom);
string pretty = make_geojson(geom, 2);
    @endcode

    @throw GEOS-ERROR error writing GeoJSON

*/
string make_geojson(GEOSGeometry[QoreGEOSGeometry] geom, int indent = -1) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSGeoJSONWriter* writer = GEOSGeoJSONWriter_create_r(ctx);
    if (!writer) {
        xsink->raiseException("GEOS-ERROR", "failed to create GeoJSON writer");
        return QoreValue();
    }
    char* json = GEOSGeoJSONWriter_writeGeometry_r(ctx, writer, geom->getGeometry(), indent);
    GEOSGeoJSONWriter_destroy_r(ctx, writer);
    if (!json) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "make_geojson")) {
            xsink->raiseException("GEOS-ERROR", "error writing GeoJSON");
        }
        return QoreValue();
    }
    QoreStringNode* rv = new QoreStringNode(json);
    GEOSFree_r(ctx, json);
    return rv;
}

//! Creates a rectangle polygon from bounding box coordinates
/** @param xmin the minimum X coordinate
    @param ymin the minimum Y coordinate
    @param xmax the maximum X coordinate
    @param ymax the maximum Y coordinate
    @return a new GEOSGeometry rectangle polygon

    @par Example:
    @code{.py}
GEOSGeometry rect = geos_create_rectangle(0, 0, 10, 20);
assertEq(200.0, rect.area());
    @endcode

    @throw GEOS-ERROR error creating rectangle

*/
GEOSGeometry geos_create_rectangle(float xmin, float ymin, float xmax, float ymax) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSGeometry* geom = GEOSGeom_createRectangle_r(ctx, xmin, ymin, xmax, ymax);
    if (!geom) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "geos_create_rectangle")) {
            xsink->raiseException("GEOS-ERROR", "failed to create rectangle");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(geom));
}

//! Creates polygons from a list of linework geometries
/** Takes a list of GEOSGeometry objects representing linework (typically LineStrings)
    and attempts to polygonize them, creating polygons from the closed rings formed
    by the input lines.

    @param geoms a list of GEOSGeometry objects representing linework

    @return a new GEOSGeometry collection of polygons formed from the input linework

    @par Example:
    @code{.py}
auto lines = (
    parse_wkt("LINESTRING (0 0, 10 0)"),
    parse_wkt("LINESTRING (10 0, 10 10)"),
    parse_wkt("LINESTRING (10 10, 0 10)"),
    parse_wkt("LINESTRING (0 10, 0 0)"),
);
GEOSGeometry polys = geos_polygonize(lines);
printf("num polygons: %d\n", polys.numGeometries());
    @endcode

    @throw GEOS-ERROR error polygonizing geometries or invalid input

    @since geos 1.2
*/
GEOSGeometry geos_polygonize(list geoms) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();

    size_t ngeoms = geoms->size();
    GEOSGeometry** geos_geoms = new GEOSGeometry*[ngeoms];
    for (size_t i = 0; i < ngeoms; ++i) {
        if (!(i % 100) && qore_check_cancel(xsink)) {
            for (size_t j = 0; j < i; ++j) {
                GEOSGeom_destroy_r(ctx, geos_geoms[j]);
            }
            delete[] geos_geoms;
            return QoreValue();
        }
        QoreObject* obj = geoms->retrieveEntry(i).get<QoreObject>();
        QoreGEOSGeometry* qg = static_cast<QoreGEOSGeometry*>(
            obj->getReferencedPrivateData(CID_GEOSGEOMETRY, xsink));
        if (!qg) {
            for (size_t j = 0; j < i; ++j) {
                GEOSGeom_destroy_r(ctx, geos_geoms[j]);
            }
            delete[] geos_geoms;
            if (!*xsink) {
                xsink->raiseException("GEOS-ERROR", "element %zu is not a GEOSGeometry", i);
            }
            return QoreValue();
        }
        geos_geoms[i] = GEOSGeom_clone_r(ctx, qg->getGeometry());
        qg->deref(xsink);
        if (!geos_geoms[i]) {
            for (size_t j = 0; j < i; ++j) {
                GEOSGeom_destroy_r(ctx, geos_geoms[j]);
            }
            delete[] geos_geoms;
            xsink->raiseException("GEOS-ERROR", "failed to clone geometry %zu", i);
            return QoreValue();
        }
    }

    GEOSGeometry* result = GEOSPolygonize_r(ctx, geos_geoms, ngeoms);
    // GEOSPolygonize_r does not take ownership; free cloned geometries
    for (size_t i = 0; i < ngeoms; ++i) {
        GEOSGeom_destroy_r(ctx, geos_geoms[i]);
    }
    delete[] geos_geoms;

    if (!result) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "geos_polygonize")) {
            xsink->raiseException("GEOS-ERROR", "failed to polygonize geometries");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(result));
}

//! Performs DBSCAN clustering on a geometry collection
/** Takes a geometry collection and clusters the component geometries using the
    DBSCAN algorithm with the given distance threshold and minimum points.

    @param geom the geometry collection to cluster
    @param eps the distance threshold for clustering
    @param minPoints the minimum number of points to form a cluster

    @return a hash with keys:
    - \c numClusters (int): the number of clusters found
    - \c assignments (list<int>): cluster index for each input geometry (-1 means noise)

    @par Example:
    @code{.py}
GEOSGeometry points = parse_wkt("MULTIPOINT ((0 0), (1 0), (0 1), (10 10), (11 10))");
hash<auto> result = geos_cluster_dbscan(points, 3.0, 2);
printf("clusters: %d\n", result.numClusters);
printf("assignments: %y\n", result.assignments);
    @endcode

    @throw GEOS-ERROR error in DBSCAN clustering

    @since geos 1.3
*/
hash<auto> geos_cluster_dbscan(GEOSGeometry[QoreGEOSGeometry] geom, float eps, int minPoints) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSClusterInfo* info = GEOSClusterDBSCAN_r(ctx, geom->getGeometry(), eps, minPoints);
    if (!info) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "geos_cluster_dbscan")) {
            xsink->raiseException("GEOS-ERROR", "error in DBSCAN clustering");
        }
        return QoreValue();
    }
    size_t numClusters = GEOSClusterInfo_getNumClusters_r(ctx, info);
    int numGeoms = GEOSGetNumGeometries_r(ctx, geom->getGeometry());

    size_t* assignments = GEOSClusterInfo_getClustersForInputs_r(ctx, info);

    ReferenceHolder<QoreListNode> assign_list(new QoreListNode(bigIntTypeInfo), xsink);
    for (int i = 0; i < numGeoms; ++i) {
        if (!(i % 100) && qore_check_cancel(xsink)) {
            GEOSFree_r(ctx, assignments);
            GEOSClusterInfo_destroy_r(ctx, info);
            return QoreValue();
        }
        // SIZE_MAX means noise (-1 in our convention)
        if (assignments[i] == SIZE_MAX) {
            assign_list->push(-1, xsink);
        } else {
            assign_list->push((int64)assignments[i], xsink);
        }
    }
    GEOSFree_r(ctx, assignments);
    GEOSClusterInfo_destroy_r(ctx, info);

    ReferenceHolder<QoreHashNode> h(new QoreHashNode(autoTypeInfo), xsink);
    h->setKeyValue("numClusters", (int64)numClusters, xsink);
    h->setKeyValue("assignments", assign_list.release(), xsink);
    return h.release();
}

//! Computes the orientation index of a point relative to a directed line
/** Returns whether point P lies to the left of, to the right of, or on the
    directed line from A to B.

    @param ax the X coordinate of point A
    @param ay the Y coordinate of point A
    @param bx the X coordinate of point B
    @param by the Y coordinate of point B
    @param px the X coordinate of point P
    @param py the Y coordinate of point P

    @return -1 if P is to the right of A-B, 0 if collinear, 1 if to the left

    @par Example:
    @code{.py}
int oi = geos_orientation_index(0.0, 0.0, 10.0, 0.0, 5.0, 5.0);
# oi == 1 (left)
    @endcode

    @since geos 1.3
*/
int geos_orientation_index(float ax, float ay, float bx, float by, float px, float py) [flags=CONSTANT] {
    GEOSContextHandle_t ctx = geos_get_context();
    return GEOSOrientationIndex_r(ctx, ax, ay, bx, by, px, py);
}

//! Computes the intersection point of two line segments
/** Computes the intersection point of the line segment from (ax, ay) to (bx, by)
    and the line segment from (cx, cy) to (dx, dy).

    @param ax the X coordinate of the first endpoint of segment 1
    @param ay the Y coordinate of the first endpoint of segment 1
    @param bx the X coordinate of the second endpoint of segment 1
    @param by the Y coordinate of the second endpoint of segment 1
    @param cx the X coordinate of the first endpoint of segment 2
    @param cy the Y coordinate of the first endpoint of segment 2
    @param dx the X coordinate of the second endpoint of segment 2
    @param dy the Y coordinate of the second endpoint of segment 2

    @return a @ref GEOSCoordinate hash with the intersection point

    @par Example:
    @code{.py}
hash<GEOSCoordinate> pt = geos_segment_intersection(0, 0, 10, 10, 0, 10, 10, 0);
# pt.x == 5.0, pt.y == 5.0
    @endcode

    @throw GEOS-ERROR no intersection or error computing intersection

    @since geos 1.3
*/
hash<GEOSCoordinate> geos_segment_intersection(float ax, float ay, float bx, float by, float cx, float cy, float dx, float dy) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    double rx, ry;
    int rv = GEOSSegmentIntersection_r(ctx, ax, ay, bx, by, cx, cy, dx, dy, &rx, &ry);
    if (rv == 0) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "geos_segment_intersection")) {
            xsink->raiseException("GEOS-ERROR", "no intersection or error computing segment intersection");
        }
        return QoreValue();
    }
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(hashdeclGEOSCoordinate, xsink), xsink);
    h->setKeyValue("x", rx, xsink);
    h->setKeyValue("y", ry, xsink);
    return h.release();
}
///@}
