#include "QC_GEOSPreparedGeometry.h"
#include "QC_GEOSGeometry.h"

//! Pre-indexed geometry for fast repeated spatial queries
/** A prepared geometry pre-computes spatial indexes on a geometry so that
    repeated spatial predicate tests against different test geometries are
    much faster than using the standard GEOSGeometry predicates.

    @par Example:
    @code{.py}
GEOSGeometry poly = new GEOSGeometry("POLYGON ((0 0, 10 0, 10 10, 0 10, 0 0))");
GEOSPreparedGeometry pg = poly.prepare();
for (int i = 0; i < 1000; ++i) {
    GEOSGeometry pt = new GEOSGeometry(sprintf("POINT (%d %d)", i % 10, i / 100));
    if (pg.contains(pt)) {
        # ...
    }
}
    @endcode

    @note The prepared geometry holds a strong reference to the source
    GEOSGeometry QoreObject, preventing it from being garbage collected.

*/
qclass GEOSPreparedGeometry [arg=QoreGEOSPreparedGeometry* pg; ns=Qore::GEOS];

//! This class cannot be directly instantiated; use GEOSGeometry::prepare()
/** @throw GEOSPREPAREDGEOMETRY-CONSTRUCTOR-ERROR this class cannot be directly instantiated
*/
GEOSPreparedGeometry::constructor() {
    xsink->raiseException("GEOSPREPAREDGEOMETRY-CONSTRUCTOR-ERROR",
        "GEOSPreparedGeometry objects can only be created by calling GEOSGeometry::prepare()");
}

//! Tests whether the prepared geometry contains the given geometry
/** @param other the geometry to test
    @return @ref True if this geometry contains the other geometry

    @throw GEOS-ERROR error in spatial predicate
*/
bool GEOSPreparedGeometry::contains(GEOSGeometry[QoreGEOSGeometry] other) [flags=NAMED_ARGS] {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    char rv = GEOSPreparedContains_r(ctx, pg->getPreparedGeometry(), other->getGeometry());
    if (rv == 2) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "prepared contains")) {
            xsink->raiseException("GEOS-ERROR", "error in prepared contains predicate");
        }
        return QoreValue();
    }
    return (bool)rv;
}

