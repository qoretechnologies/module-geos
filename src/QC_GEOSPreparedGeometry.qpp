    return (bool)rv;
#else
    xsink->raiseException("GEOS-ERROR", "intersectsXY() requires GEOS >= 3.12 (installed: " GEOS_VERSION ")");
    return QoreValue();
#endif
}

//! Returns the nearest points of the prepared geometry and the given geometry
/** @param other the other geometry
    @return a list of two @ref GEOSCoordinate hashes representing the nearest points

    @throw GEOS-ERROR error computing nearest points

*/
list<hash<GEOSCoordinate>> GEOSPreparedGeometry::nearestPoints(GEOSGeometry[QoreGEOSGeometry] other) [flags=NAMED_ARGS] {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSCoordSequence* cs = GEOSPreparedNearestPoints_r(ctx, pg->getPreparedGeometry(), other->getGeometry());
    if (!cs) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "prepared nearestPoints")) {
            xsink->raiseException("GEOS-ERROR", "error computing prepared nearest points");
        }
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> result(new QoreListNode(hashdeclGEOSCoordinate->getTypeInfo()), xsink);
    unsigned int size;
    GEOSCoordSeq_getSize_r(ctx, cs, &size);
    for (unsigned int i = 0; i < size; ++i) {
        double x, y;
        GEOSCoordSeq_getX_r(ctx, cs, i, &x);
        GEOSCoordSeq_getY_r(ctx, cs, i, &y);
        ReferenceHolder<QoreHashNode> h(new QoreHashNode(hashdeclGEOSCoordinate, xsink), xsink);
        h->setKeyValue("x", x, xsink);
        h->setKeyValue("y", y, xsink);
        // try to get Z coordinate
        unsigned int dims;
        GEOSCoordSeq_getDimensions_r(ctx, cs, &dims);
        if (dims >= 3) {
            double z;
            GEOSCoordSeq_getZ_r(ctx, cs, i, &z);
            h->setKeyValue("z", z, xsink);
        }
        result->push(h.release(), xsink);
    }
    GEOSCoordSeq_destroy_r(ctx, cs);
    return result.release();
}

//! Returns the DE-9IM intersection matrix for the prepared geometry and another
/** @param other the geometry to compute the relationship with
    @return a 9-character string representing the DE-9IM matrix

    @throw GEOS-ERROR error computing relate matrix

*/
string GEOSPreparedGeometry::relate(GEOSGeometry[QoreGEOSGeometry] other) [flags=NAMED_ARGS] {
#if GEOS_VERSION_MAJOR > 3 || (GEOS_VERSION_MAJOR == 3 && GEOS_VERSION_MINOR >= 14)
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    char* matrix = GEOSPreparedRelate_r(ctx, pg->getPreparedGeometry(), other->getGeometry());
    if (!matrix) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "prepared relate")) {
            xsink->raiseException("GEOS-ERROR", "error computing prepared DE-9IM relate matrix");
        }
        return QoreValue();
    }
    QoreStringNode* rv = new QoreStringNode(matrix);
    GEOSFree_r(ctx, matrix);
    return rv;
#else
    xsink->raiseException("GEOS-ERROR", "relate() requires GEOS >= 3.14 (installed: " GEOS_VERSION ")");
    return QoreValue();
#endif
}

//! Tests whether the DE-9IM intersection matrix for the prepared geometry matches a pattern
/** @param other the geometry to compute the relationship with
    @param pattern the DE-9IM pattern to match (may contain T, F, *, 0-9)
    @return @ref True if the relationship matches the pattern

    @throw GEOS-ERROR error testing relate pattern

*/
bool GEOSPreparedGeometry::relatePattern(GEOSGeometry[QoreGEOSGeometry] other, string pattern) [flags=NAMED_ARGS] {
#if GEOS_VERSION_MAJOR > 3 || (GEOS_VERSION_MAJOR == 3 && GEOS_VERSION_MINOR >= 14)
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    char rv = GEOSPreparedRelatePattern_r(ctx, pg->getPreparedGeometry(), other->getGeometry(), pattern->c_str());
    if (rv == 2) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "prepared relatePattern")) {
            xsink->raiseException("GEOS-ERROR", "error testing prepared DE-9IM pattern");
        }
        return QoreValue();
    }
    return (bool)rv;
#else
    xsink->raiseException("GEOS-ERROR", "relatePattern() requires GEOS >= 3.14 (installed: " GEOS_VERSION ")");
    return QoreValue();
#endif
}
