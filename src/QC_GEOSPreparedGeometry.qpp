    return (bool)rv;
}

//! Tests whether the prepared geometry is covered by the given geometry
/** @param other the geometry to test
    @return @ref True if this geometry is covered by the other geometry

    @throw GEOS-ERROR error in spatial predicate
*/
bool GEOSPreparedGeometry::coveredBy(GEOSGeometry[QoreGEOSGeometry] other) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    char rv = GEOSPreparedCoveredBy_r(ctx, pg->getPreparedGeometry(), other->getGeometry());
    if (rv == 2) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "prepared coveredBy")) {
            xsink->raiseException("GEOS-ERROR", "error in prepared coveredBy predicate");
        }
        return QoreValue();
    }
    return (bool)rv;
}
