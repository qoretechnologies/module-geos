//! Computes the distance between the prepared geometry and another geometry
/** @param other the geometry to compute distance to
    @return the distance between the closest points of the two geometries

    @throw GEOS-ERROR error computing distance

*/
float GEOSPreparedGeometry::distance(GEOSGeometry[QoreGEOSGeometry] other) [flags=NAMED_ARGS] {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    double dist;
    if (!GEOSPreparedDistance_r(ctx, pg->getPreparedGeometry(), other->getGeometry(), &dist)) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "prepared distance")) {
            xsink->raiseException("GEOS-ERROR", "error computing prepared distance");
        }
        return QoreValue();
    }
    return dist;
}

//! Tests whether the distance between the prepared geometry and another is within a given value
/** @param other the geometry to test
    @param distance the distance threshold
    @return @ref True if the distance is within the threshold

    @throw GEOS-ERROR error in distance computation

*/
bool GEOSPreparedGeometry::distanceWithin(GEOSGeometry[QoreGEOSGeometry] other, float distance) [flags=NAMED_ARGS] {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    char rv = GEOSPreparedDistanceWithin_r(ctx, pg->getPreparedGeometry(), other->getGeometry(), distance);
    if (rv == 2) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "prepared distanceWithin")) {
            xsink->raiseException("GEOS-ERROR", "error in prepared distanceWithin");
        }
        return QoreValue();
    }
    return (bool)rv;
}

//! Tests whether the prepared geometry contains the given point coordinates
/** @param x the X coordinate
    @param y the Y coordinate
    @return @ref True if this geometry contains the point (x, y)

    @throw GEOS-ERROR error in spatial predicate

*/
bool GEOSPreparedGeometry::containsXY(float x, float y) [flags=NAMED_ARGS] {
#if GEOS_VERSION_MAJOR > 3 || (GEOS_VERSION_MAJOR == 3 && GEOS_VERSION_MINOR >= 12)
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    char rv = GEOSPreparedContainsXY_r(ctx, pg->getPreparedGeometry(), x, y);
    if (rv == 2) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "prepared containsXY")) {
            xsink->raiseException("GEOS-ERROR", "error in prepared containsXY predicate");
        }
        return QoreValue();
    }
    return (bool)rv;
#else
    xsink->raiseException("GEOS-ERROR", "containsXY() requires GEOS >= 3.12 (installed: " GEOS_VERSION ")");
    return QoreValue();
#endif
}

//! Tests whether the prepared geometry intersects the given point coordinates
/** @param x the X coordinate
    @param y the Y coordinate
    @return @ref True if this geometry intersects the point (x, y)

    @throw GEOS-ERROR error in spatial predicate

*/
bool GEOSPreparedGeometry::intersectsXY(float x, float y) [flags=NAMED_ARGS] {
#if GEOS_VERSION_MAJOR > 3 || (GEOS_VERSION_MAJOR == 3 && GEOS_VERSION_MINOR >= 12)
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
