#include "QC_GEOSGeoJSONReader.h"
#include "QC_GEOSGeometry.h"

//! GeoJSON reader for parsing GeoJSON geometry strings
/** A single geometry or \c Feature is parsed as a geometry.
    A \c FeatureCollection is parsed as a \c GeometryCollection.

    @par Example:
    @code{.py}
GEOSGeoJSONReader reader();
GEOSGeometry geom = reader.read('{"type": "Point", "coordinates": [1.0, 2.0]}');
    @endcode

    @since geos 1.0
*/
qclass GEOSGeoJSONReader [arg=QoreGEOSGeoJSONReader* r; ns=Qore::GEOS];

//! Creates a new GeoJSON reader
/**
*/
GEOSGeoJSONReader::constructor() {
    self->setPrivate(CID_GEOSGEOJSONREADER, new QoreGEOSGeoJSONReader());
}

//! Reads a GeoJSON string and returns a GEOSGeometry object
/** @param geojson the GeoJSON string to parse
    @return a new GEOSGeometry object

    @throw GEOS-ERROR error parsing GeoJSON string
*/
GEOSGeometry GEOSGeoJSONReader::read(string geojson) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSGeometry* geom = GEOSGeoJSONReader_readGeometry_r(ctx, r->getReader(), geojson->c_str());
    if (!geom) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "GeoJSONReader::read")) {
            xsink->raiseException("GEOS-ERROR", "failed to parse GeoJSON string");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(geom));
}
