#include "QC_GEOSWKTWriter.h"
#include "QC_GEOSGeometry.h"

//! WKT (Well-Known Text) writer for serializing geometries to strings
/** @par Example:
    @code{.py}
GEOSWKTWriter writer();
writer.setTrim(True);
writer.setRoundingPrecision(3);
string wkt = writer.write(geom);
    @endcode

*/
qclass GEOSWKTWriter [arg=QoreGEOSWKTWriter* w; ns=Qore::GEOS];

//! Creates a new WKT writer
/**
*/
GEOSWKTWriter::constructor() {
    self->setPrivate(CID_GEOSWKTWRITER, new QoreGEOSWKTWriter());
}

//! Writes a geometry to a WKT string
/** @param geometry the geometry to serialize
    @return the WKT string

    @throw GEOS-ERROR error writing WKT
*/
string GEOSWKTWriter::write(GEOSGeometry[QoreGEOSGeometry] geometry) [flags=NAMED_ARGS] {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    char* wkt = GEOSWKTWriter_write_r(ctx, w->getWriter(), geometry->getGeometry());
    if (!wkt) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "WKTWriter::write")) {
            xsink->raiseException("GEOS-ERROR", "error writing WKT");
        }
        return QoreValue();
    }
    QoreStringNode* rv = new QoreStringNode(wkt);
    GEOSFree_r(ctx, wkt);
    return rv;
}

//! Sets whether to trim unnecessary trailing zeros
/** @param enabled @ref True to trim trailing zeros
*/
nothing GEOSWKTWriter::setTrim(bool enabled) [flags=NAMED_ARGS] {
    GEOSWKTWriter_setTrim_r(geos_get_context(), w->getWriter(), enabled ? 1 : 0);
}

//! Sets the rounding precision for coordinates
/** @param precision the number of decimal places
*/
nothing GEOSWKTWriter::setRoundingPrecision(int precision) [flags=NAMED_ARGS] {
    GEOSWKTWriter_setRoundingPrecision_r(geos_get_context(), w->getWriter(), precision);
}

//! Sets the output dimension (2 or 3)
/** @param dimension the output dimension
*/
nothing GEOSWKTWriter::setOutputDimension(int dimension) [flags=NAMED_ARGS] {
    GEOSWKTWriter_setOutputDimension_r(geos_get_context(), w->getWriter(), dimension);
}
