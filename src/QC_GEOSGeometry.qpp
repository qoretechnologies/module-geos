//! Returns the boundary of this geometry
/** @return a new GEOSGeometry representing the boundary

    @throw GEOS-ERROR error computing boundary
*/
GEOSGeometry GEOSGeometry::boundary() {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSGeometry* result = GEOSBoundary_r(ctx, g->getGeometry());
    if (!result) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "boundary")) {
            xsink->raiseException("GEOS-ERROR", "error computing boundary");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(result));
}

//! Returns the geometry type as a string
/** @return the geometry type (e.g., "Point", "LineString", "Polygon", etc.)
*/
string GEOSGeometry::geometryType() [flags=RET_VALUE_ONLY] {
    GEOSContextHandle_t ctx = geos_get_context();
    char* type = GEOSGeomType_r(ctx, g->getGeometry());
    if (!type) {
        return QoreValue();
    }
    QoreStringNode* rv = new QoreStringNode(type);
    GEOSFree_r(ctx, type);
    return rv;
}

