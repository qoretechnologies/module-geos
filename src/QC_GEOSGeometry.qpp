#include "QC_GEOSGeometry.h"
#include "QC_GEOSPreparedGeometry.h"
#include "QC_GEOSGeoJSONWriter.h"

// Data passed to the transform_xy_trampoline callback
struct TransformXYData {
    const ResolvedCallReferenceNode* callback;
    ExceptionSink* xsink;
};

// Trampoline function for GEOSGeom_transformXY_r
static int transform_xy_trampoline(double* x, double* y, void* userdata) {
    TransformXYData* data = static_cast<TransformXYData*>(userdata);
    if (*data->xsink) {
        return 0;  // already have an error
    }

    ReferenceHolder<QoreListNode> args(new QoreListNode(autoTypeInfo), data->xsink);
    args->push(*x, data->xsink);
    args->push(*y, data->xsink);

    ValueHolder rv(data->callback->execValue(*args, data->xsink), data->xsink);
    if (*data->xsink) {
        return 0;
    }

    // expect a list with [new_x, new_y] or a hash with "x" and "y"
    if (rv->getType() == NT_LIST) {
        const QoreListNode* l = rv->get<const QoreListNode>();
        if (l->size() >= 2) {
            *x = l->retrieveEntry(0).getAsFloat();
            *y = l->retrieveEntry(1).getAsFloat();
            return 1;
        }
    } else if (rv->getType() == NT_HASH) {
        const QoreHashNode* h = rv->get<const QoreHashNode>();
        *x = h->getKeyValue("x").getAsFloat();
        *y = h->getKeyValue("y").getAsFloat();
        return 1;
    }
    data->xsink->raiseException("GEOS-ERROR",
        "transformXY callback must return a list (x, y) or hash with 'x' and 'y' keys");
    return 0;
}

//! Core geometry class wrapping the GEOS GEOSGeometry type
/** This class provides the main interface for working with geometries in GEOS.
    Geometries can be created from WKT strings or WKB binary data, and support
    spatial predicates, topology operations, and serialization.

    @par Example:
    @code{.py}
GEOSGeometry point = new GEOSGeometry("POINT (1.0 2.0)");
GEOSGeometry poly = new GEOSGeometry("POLYGON ((0 0, 10 0, 10 10, 0 10, 0 0))");
printf("contains: %y\n", poly.contains(point));
printf("area: %y\n", poly.area());
    @endcode

*/
qclass GEOSGeometry [arg=QoreGEOSGeometry* g; ns=Qore::GEOS];

//! Creates a GEOSGeometry object from a WKT string
/** @param wkt the Well-Known Text representation of the geometry

    @par Example:
    @code{.py}
GEOSGeometry geom = new GEOSGeometry("POINT (1.0 2.0)");
    @endcode

    @throw GEOS-ERROR error parsing WKT string
*/
GEOSGeometry::constructor(string wkt) [flags=NAMED_ARGS] {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSWKTReader* reader = GEOSWKTReader_create_r(ctx);
    if (!reader) {
        xsink->raiseException("GEOS-ERROR", "failed to create WKT reader");
        return;
    }
    GEOSGeometry* geom = GEOSWKTReader_read_r(ctx, reader, wkt->c_str());
    GEOSWKTReader_destroy_r(ctx, reader);
    if (!geom) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "failed to parse WKT")) {
            xsink->raiseException("GEOS-ERROR", "failed to parse WKT string");
        }
        return;
    }
    self->setPrivate(CID_GEOSGEOMETRY, new QoreGEOSGeometry(geom));
}

//! Creates a GEOSGeometry object from WKB binary data
/** @param wkb the Well-Known Binary representation of the geometry

    @par Example:
    @code{.py}
GEOSGeometry geom = new GEOSGeometry(wkb_data);
    @endcode

    @throw GEOS-ERROR error parsing WKB data
*/
GEOSGeometry::constructor(binary wkb) [flags=NAMED_ARGS] {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSWKBReader* reader = GEOSWKBReader_create_r(ctx);
    if (!reader) {
        xsink->raiseException("GEOS-ERROR", "failed to create WKB reader");
        return;
    }
    GEOSGeometry* geom = GEOSWKBReader_read_r(ctx, reader,
        static_cast<const unsigned char*>(wkb->getPtr()), wkb->size());
    GEOSWKBReader_destroy_r(ctx, reader);
    if (!geom) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "failed to parse WKB")) {
            xsink->raiseException("GEOS-ERROR", "failed to parse WKB data");
        }
        return;
    }
    self->setPrivate(CID_GEOSGEOMETRY, new QoreGEOSGeometry(geom));
}

//! Creates a copy of the geometry
/** @par Example:
    @code{.py}
GEOSGeometry copy = geom.copy();
    @endcode

    @throw GEOS-ERROR error copying geometry
*/
GEOSGeometry::copy() {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSGeometry* clone = GEOSGeom_clone_r(ctx, g->getGeometry());
    if (!clone) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "failed to clone geometry")) {
            xsink->raiseException("GEOS-ERROR", "failed to clone geometry");
        }
        return;
    }
    self->setPrivate(CID_GEOSGEOMETRY, new QoreGEOSGeometry(clone));
}

//! Tests whether this geometry contains the given geometry
/** @param other the geometry to test
    @return @ref True if this geometry contains the other geometry

    @par Example:
    @code{.py}
bool result = poly.contains(point);
    @endcode

    @throw GEOS-ERROR error in spatial predicate
*/
bool GEOSGeometry::contains(GEOSGeometry[QoreGEOSGeometry] other) [flags=NAMED_ARGS] {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    char rv = GEOSContains_r(ctx, g->getGeometry(), other->getGeometry());
    if (rv == 2) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "contains")) {
            xsink->raiseException("GEOS-ERROR", "error in contains predicate");
        }
        return QoreValue();
    }
    return (bool)rv;
}

