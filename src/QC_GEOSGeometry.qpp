    return (bool)GEOSisSimple_r(ctx, g->getGeometry());
}

//! Returns the area of this geometry
/** @return the area (0.0 for non-areal geometries)

    @throw GEOS-ERROR error computing area
*/
float GEOSGeometry::area() {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    double area;
    if (!GEOSArea_r(ctx, g->getGeometry(), &area)) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "area")) {
            xsink->raiseException("GEOS-ERROR", "error computing area");
        }
        return QoreValue();
    }
    return area;
}

//! Returns the length of this geometry
/** @return the length (0.0 for non-lineal geometries)

    @throw GEOS-ERROR error computing length
*/
float GEOSGeometry::length() {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    double len;
    if (!GEOSLength_r(ctx, g->getGeometry(), &len)) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "length")) {
            xsink->raiseException("GEOS-ERROR", "error computing length");
        }
        return QoreValue();
    }
    return len;
}

//! Returns the SRID (Spatial Reference System Identifier) of this geometry
/** @return the SRID
*/
int GEOSGeometry::getSRID() [flags=RET_VALUE_ONLY] {
    GEOSContextHandle_t ctx = geos_get_context();
    return GEOSGetSRID_r(ctx, g->getGeometry());
}

//! Sets the SRID (Spatial Reference System Identifier) of this geometry
/** @param srid the SRID to set
*/
nothing GEOSGeometry::setSRID(int srid) {
    GEOSContextHandle_t ctx = geos_get_context();
    GEOSSetSRID_r(ctx, g->getGeometry(), srid);
}

//! Returns the first coordinate of this geometry
/** @return a @ref GEOSCoordinate hash, or @ref nothing if the geometry is empty

    @throw GEOS-ERROR error getting coordinate
*/
*hash<GEOSCoordinate> GEOSGeometry::getCoordinate() {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    const GEOSCoordSequence* cs = GEOSGeom_getCoordSeq_r(ctx, g->getGeometry());
    if (!cs) {
        check_geos_error(xsink, "GEOS-ERROR", "getCoordinate");
        return QoreValue();
    }
    unsigned int size;
    GEOSCoordSeq_getSize_r(ctx, cs, &size);
    if (size == 0) {
        return QoreValue();
    }
    double x, y;
    GEOSCoordSeq_getX_r(ctx, cs, 0, &x);
    GEOSCoordSeq_getY_r(ctx, cs, 0, &y);
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(hashdeclGEOSCoordinate, xsink), xsink);
    h->setKeyValue("x", x, xsink);
    h->setKeyValue("y", y, xsink);
    unsigned int dims;
    GEOSCoordSeq_getDimensions_r(ctx, cs, &dims);
    if (dims >= 3) {
        double z;
        GEOSCoordSeq_getZ_r(ctx, cs, 0, &z);
        h->setKeyValue("z", z, xsink);
    }
    return h.release();
}

//! Returns all coordinates of this geometry
/** @return a list of @ref GEOSCoordinate hashes

    @throw GEOS-ERROR error getting coordinates
*/
list<hash<GEOSCoordinate>> GEOSGeometry::getCoordinates() {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    const GEOSCoordSequence* cs = GEOSGeom_getCoordSeq_r(ctx, g->getGeometry());
    if (!cs) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "getCoordinates")) {
            xsink->raiseException("GEOS-ERROR", "error getting coordinate sequence");
        }
        return QoreValue();
    }
    unsigned int size;
    GEOSCoordSeq_getSize_r(ctx, cs, &size);
    unsigned int dims;
    GEOSCoordSeq_getDimensions_r(ctx, cs, &dims);

    ReferenceHolder<QoreListNode> result(new QoreListNode(hashdeclGEOSCoordinate->getTypeInfo()), xsink);
    for (unsigned int i = 0; i < size; ++i) {
        double x, y;
        GEOSCoordSeq_getX_r(ctx, cs, i, &x);
        GEOSCoordSeq_getY_r(ctx, cs, i, &y);
        ReferenceHolder<QoreHashNode> h(new QoreHashNode(hashdeclGEOSCoordinate, xsink), xsink);
        h->setKeyValue("x", x, xsink);
        h->setKeyValue("y", y, xsink);
        if (dims >= 3) {
            double z;
            GEOSCoordSeq_getZ_r(ctx, cs, i, &z);
            h->setKeyValue("z", z, xsink);
        }
        result->push(h.release(), xsink);
    }
    return result.release();
}

//! Returns the Nth sub-geometry from a geometry collection
/** The returned geometry is a clone (not a borrowed reference).

    @param n the zero-based index of the sub-geometry
    @return a new GEOSGeometry object

    @throw GEOS-ERROR index out of range or error getting sub-geometry
*/
GEOSGeometry GEOSGeometry::getGeometryN(int n) {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    int num = GEOSGetNumGeometries_r(ctx, g->getGeometry());
    if (n < 0 || n >= num) {
        xsink->raiseException("GEOS-ERROR", "geometry index %d out of range (0..%d)", (int)n, num - 1);
        return QoreValue();
    }
    const GEOSGeometry* sub = GEOSGetGeometryN_r(ctx, g->getGeometry(), n);
    if (!sub) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "getGeometryN")) {
            xsink->raiseException("GEOS-ERROR", "error getting sub-geometry at index %d", (int)n);
        }
        return QoreValue();
    }
    // clone the borrowed pointer since GEOS owns it
    GEOSGeometry* clone = GEOSGeom_clone_r(ctx, sub);
    if (!clone) {
        xsink->raiseException("GEOS-ERROR", "error cloning sub-geometry");
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(clone));
}

//! Returns the WKT representation of this geometry
/** @return the Well-Known Text string

    @throw GEOS-ERROR error serializing to WKT
*/
string GEOSGeometry::toWKT() {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSWKTWriter* writer = GEOSWKTWriter_create_r(ctx);
    if (!writer) {
        xsink->raiseException("GEOS-ERROR", "failed to create WKT writer");
        return QoreValue();
    }
    GEOSWKTWriter_setTrim_r(ctx, writer, 1);
    char* wkt = GEOSWKTWriter_write_r(ctx, writer, g->getGeometry());
    GEOSWKTWriter_destroy_r(ctx, writer);
    if (!wkt) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "toWKT")) {
            xsink->raiseException("GEOS-ERROR", "error writing WKT");
        }
        return QoreValue();
    }
    QoreStringNode* rv = new QoreStringNode(wkt);
    GEOSFree_r(ctx, wkt);
    return rv;
}

//! Returns the WKB representation of this geometry
/** @return the Well-Known Binary data

    @throw GEOS-ERROR error serializing to WKB
*/
binary GEOSGeometry::toWKB() {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSWKBWriter* writer = GEOSWKBWriter_create_r(ctx);
    if (!writer) {
        xsink->raiseException("GEOS-ERROR", "failed to create WKB writer");
        return QoreValue();
    }
    size_t size;
    unsigned char* wkb = GEOSWKBWriter_write_r(ctx, writer, g->getGeometry(), &size);
    GEOSWKBWriter_destroy_r(ctx, writer);
    if (!wkb) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "toWKB")) {
            xsink->raiseException("GEOS-ERROR", "error writing WKB");
        }
        return QoreValue();
    }
    BinaryNode* rv = new BinaryNode;
    rv->append(wkb, size);
    GEOSFree_r(ctx, wkb);
    return rv;
}

//! Creates a prepared geometry for fast repeated spatial queries
/** @return a new GEOSPreparedGeometry object

    @par Example:
    @code{.py}
GEOSPreparedGeometry pg = poly.prepare();
for (int i = 0; i < points.size(); ++i) {
    if (pg.contains(points[i])) {
        # ...
    }
}
    @endcode

    @throw GEOS-ERROR error preparing geometry
*/
auto GEOSGeometry::prepare() {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    const GEOSPreparedGeometry* pg = GEOSPrepare_r(ctx, g->getGeometry());
    if (!pg) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "prepare")) {
            xsink->raiseException("GEOS-ERROR", "error preparing geometry");
        }
        return QoreValue();
    }
    // hold a strong reference to the source QoreObject to prevent GC
    self->ref();
    return new QoreObject(QC_GEOSPREPAREDGEOMETRY, getProgram(),
        new QoreGEOSPreparedGeometry(pg, self));
}

//! Tests whether this geometry is a ring (closed and simple)
/** @return @ref True if the geometry is a ring

    @par Example:
    @code{.py}
GEOSGeometry ring = new GEOSGeometry("LINESTRING (0 0, 10 0, 10 10, 0 10, 0 0)");
printf("is ring: %y\n", ring.isRing()); # True
    @endcode

    @throw GEOS-ERROR error testing ring property

    @since geos 1.1
*/
bool GEOSGeometry::isRing() {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    char rv = GEOSisRing_r(ctx, g->getGeometry());
    if (rv == 2) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "isRing")) {
            xsink->raiseException("GEOS-ERROR", "error testing ring property");
        }
        return QoreValue();
    }
    return (bool)rv;
}

//! Tests whether this geometry is closed
/** A geometry is closed if its start point equals its end point.
    Points and polygons are always closed.

    @return @ref True if the geometry is closed

    @par Example:
    @code{.py}
GEOSGeometry line = new GEOSGeometry("LINESTRING (0 0, 10 0, 10 10, 0 10, 0 0)");
printf("is closed: %y\n", line.isClosed()); # True
    @endcode

    @throw GEOS-ERROR error testing closed property

    @since geos 1.1
*/
bool GEOSGeometry::isClosed() {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    char rv = GEOSisClosed_r(ctx, g->getGeometry());
    if (rv == 2) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "isClosed")) {
            xsink->raiseException("GEOS-ERROR", "error testing closed property");
        }
        return QoreValue();
    }
    return (bool)rv;
}

//! Tests whether this geometry has Z coordinates
/** @return @ref True if the geometry has Z (3D) coordinates

    @par Example:
    @code{.py}
GEOSGeometry pt3d = new GEOSGeometry("POINT Z (1 2 3)");
printf("has Z: %y\n", pt3d.hasZ()); # True
    @endcode

    @throw GEOS-ERROR error testing Z coordinate presence

    @since geos 1.1
*/
bool GEOSGeometry::hasZ() {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    char rv = GEOSHasZ_r(ctx, g->getGeometry());
    if (rv == 2) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "hasZ")) {
            xsink->raiseException("GEOS-ERROR", "error testing Z coordinate presence");
        }
        return QoreValue();
    }
    return (bool)rv;
}

//! Returns the geometry type as an integer constant
/** @return the geometry type ID; one of the @ref geos_geometry_type_constants

    @par Example:
    @code{.py}
GEOSGeometry pt = new GEOSGeometry("POINT (1 2)");
printf("type id: %d\n", pt.geometryTypeId()); # 0 (GEOS_POINT)
    @endcode

    @see @ref geos_geometry_type_constants

    @since geos 1.1
*/
int GEOSGeometry::geometryTypeId() [flags=RET_VALUE_ONLY] {
    GEOSContextHandle_t ctx = geos_get_context();
    return GEOSGeomTypeId_r(ctx, g->getGeometry());
}

//! Returns the topological dimension of this geometry
/** Returns 0 for points, 1 for lines, 2 for polygons.

    @return the topological dimension (0, 1, or 2)

    @par Example:
    @code{.py}
GEOSGeometry poly = new GEOSGeometry("POLYGON ((0 0, 10 0, 10 10, 0 10, 0 0))");
printf("dimensions: %d\n", poly.getDimensions()); # 2
    @endcode

    @since geos 1.1
*/
int GEOSGeometry::getDimensions() [flags=RET_VALUE_ONLY] {
    GEOSContextHandle_t ctx = geos_get_context();
    return GEOSGeom_getDimensions_r(ctx, g->getGeometry());
}

