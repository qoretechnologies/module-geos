//! Returns the geometry type as a string
/** @return the geometry type (e.g., "Point", "LineString", "Polygon", etc.)
*/
string GEOSGeometry::geometryType() [flags=RET_VALUE_ONLY] {
    GEOSContextHandle_t ctx = geos_get_context();
    char* type = GEOSGeomType_r(ctx, g->getGeometry());
    if (!type) {
        return QoreValue();
    }
    QoreStringNode* rv = new QoreStringNode(type);
    GEOSFree_r(ctx, type);
    return rv;
}

//! Returns the number of points in this geometry
/** @return the number of coordinate points
*/
int GEOSGeometry::numPoints() [flags=RET_VALUE_ONLY] {
    GEOSContextHandle_t ctx = geos_get_context();
    return GEOSGetNumCoordinates_r(ctx, g->getGeometry());
}

//! Returns the number of sub-geometries (for geometry collections)
/** @return the number of sub-geometries, or 1 for non-collection types
*/
int GEOSGeometry::numGeometries() [flags=RET_VALUE_ONLY] {
    GEOSContextHandle_t ctx = geos_get_context();
    return GEOSGetNumGeometries_r(ctx, g->getGeometry());
}

