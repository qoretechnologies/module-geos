//! Computes the distance between this geometry and another
/** @param other the geometry to compute distance to
    @return the distance between the closest points of the two geometries

    @par Example:
    @code{.py}
float d = geom1.distance(geom2);
    @endcode

    @throw GEOS-ERROR error computing distance
*/
float GEOSGeometry::distance(GEOSGeometry[QoreGEOSGeometry] other) [flags=NAMED_ARGS] {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    double dist;
    if (!GEOSDistance_r(ctx, g->getGeometry(), other->getGeometry(), &dist)) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "distance")) {
            xsink->raiseException("GEOS-ERROR", "error computing distance");
        }
        return QoreValue();
    }
    return dist;
}

//! Projects a point onto this geometry (linear referencing)
/** Returns the distance along this geometry to the point nearest the given point.
    This geometry must be a lineal geometry (LineString or MultiLineString).

    @param point the point to project
    @return the distance along this geometry to the nearest point

    @throw GEOS-ERROR error in projection or wrong geometry type
*/
float GEOSGeometry::project(GEOSGeometry[QoreGEOSGeometry] point) [flags=NAMED_ARGS] {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    double d = GEOSProject_r(ctx, g->getGeometry(), point->getGeometry());
    if (d < 0.0) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "project")) {
            xsink->raiseException("GEOS-ERROR", "error in project");
        }
        return QoreValue();
    }
    return d;
}

//! Projects a point onto this geometry using normalized distance
/** Returns the distance fraction (0.0 to 1.0) along this geometry to the
    point nearest the given point.

    @param point the point to project
    @return the normalized distance (0.0 - 1.0) along this geometry

    @throw GEOS-ERROR error in projection or wrong geometry type
*/
float GEOSGeometry::projectNormalized(GEOSGeometry[QoreGEOSGeometry] point) [flags=NAMED_ARGS] {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    double d = GEOSProjectNormalized_r(ctx, g->getGeometry(), point->getGeometry());
    if (d < 0.0) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "projectNormalized")) {
            xsink->raiseException("GEOS-ERROR", "error in projectNormalized");
        }
        return QoreValue();
    }
    return d;
}

//! Returns the point at the given distance along this geometry (linear referencing)
/** @param distance the distance along the geometry
    @return a new GEOSGeometry point at the given distance

    @throw GEOS-ERROR error in interpolation or wrong geometry type
*/
GEOSGeometry GEOSGeometry::interpolate(float distance) [flags=NAMED_ARGS] {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSGeometry* result = GEOSInterpolate_r(ctx, g->getGeometry(), distance);
    if (!result) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "interpolate")) {
            xsink->raiseException("GEOS-ERROR", "error in interpolate");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(result));
}

//! Returns the point at the given normalized distance along this geometry
/** @param fraction the normalized distance (0.0 - 1.0) along the geometry
    @return a new GEOSGeometry point at the given fraction

    @throw GEOS-ERROR error in interpolation or wrong geometry type
*/
GEOSGeometry GEOSGeometry::interpolateNormalized(float fraction) [flags=NAMED_ARGS] {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSGeometry* result = GEOSInterpolateNormalized_r(ctx, g->getGeometry(), fraction);
    if (!result) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "interpolateNormalized")) {
            xsink->raiseException("GEOS-ERROR", "error in interpolateNormalized");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(result));
}

//! Returns the nearest points of this geometry and the given geometry
/** @param other the other geometry
    @return a list of two @ref GEOSCoordinate hashes representing the nearest points

    @throw GEOS-ERROR error computing nearest points
*/
list<hash<GEOSCoordinate>> GEOSGeometry::nearestPoints(GEOSGeometry[QoreGEOSGeometry] other) [flags=NAMED_ARGS] {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSCoordSequence* cs = GEOSNearestPoints_r(ctx, g->getGeometry(), other->getGeometry());
    if (!cs) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "nearestPoints")) {
            xsink->raiseException("GEOS-ERROR", "error computing nearest points");
        }
        return QoreValue();
    }

    ReferenceHolder<QoreListNode> result(new QoreListNode(hashdeclGEOSCoordinate->getTypeInfo()), xsink);
    unsigned int size;
    GEOSCoordSeq_getSize_r(ctx, cs, &size);
    for (unsigned int i = 0; i < size; ++i) {
        double x, y;
        GEOSCoordSeq_getX_r(ctx, cs, i, &x);
        GEOSCoordSeq_getY_r(ctx, cs, i, &y);
        ReferenceHolder<QoreHashNode> h(new QoreHashNode(hashdeclGEOSCoordinate, xsink), xsink);
        h->setKeyValue("x", x, xsink);
        h->setKeyValue("y", y, xsink);
        // try to get Z coordinate
        unsigned int dims;
        GEOSCoordSeq_getDimensions_r(ctx, cs, &dims);
        if (dims >= 3) {
            double z;
            GEOSCoordSeq_getZ_r(ctx, cs, i, &z);
            h->setKeyValue("z", z, xsink);
        }
        result->push(h.release(), xsink);
    }
    GEOSCoordSeq_destroy_r(ctx, cs);
    return result.release();
}

//! Computes a buffer area around this geometry
/** @param width the buffer distance (positive or negative)
    @param quad_segments the number of segments to approximate a quarter circle (default 8)
    @return a new GEOSGeometry representing the buffer

    @throw GEOS-ERROR error computing buffer
*/
GEOSGeometry GEOSGeometry::buffer(float width, int quad_segments = 8) [flags=NAMED_ARGS] {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    GEOSGeometry* result = GEOSBuffer_r(ctx, g->getGeometry(), width, quad_segments);
    if (!result) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "buffer")) {
            xsink->raiseException("GEOS-ERROR", "error computing buffer");
        }
        return QoreValue();
    }
    return new QoreObject(QC_GEOSGEOMETRY, getProgram(), new QoreGEOSGeometry(result));
}

