//! Returns the full extent (bounding box) of this geometry
/** @return a @ref GEOSExtent hash with xmin, ymin, xmax, ymax

    @par Example:
    @code{.py}
GEOSGeometry poly = new GEOSGeometry("POLYGON ((0 0, 10 0, 10 10, 0 10, 0 0))");
hash<GEOSExtent> ext = poly.getExtent();
printf("bounds: %f,%f to %f,%f\n", ext.xmin, ext.ymin, ext.xmax, ext.ymax);
    @endcode

    @throw GEOS-ERROR error getting geometry extent

    @since geos 1.1
*/
hash<GEOSExtent> GEOSGeometry::getExtent() {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    double xmin, ymin, xmax, ymax;
    if (!GEOSGeom_getExtent_r(ctx, g->getGeometry(), &xmin, &ymin, &xmax, &ymax)) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "getExtent")) {
            xsink->raiseException("GEOS-ERROR", "error getting geometry extent");
        }
        return QoreValue();
    }
    ReferenceHolder<QoreHashNode> h(new QoreHashNode(hashdeclGEOSExtent, xsink), xsink);
    h->setKeyValue("xmin", xmin, xsink);
    h->setKeyValue("ymin", ymin, xsink);
    h->setKeyValue("xmax", xmax, xsink);
    h->setKeyValue("ymax", ymax, xsink);
    return h.release();
}

//! Returns the X coordinate of a point geometry
/** This method only works on Point geometries.

    @return the X coordinate value

    @throw GEOS-ERROR error getting X coordinate or geometry is not a point

    @since geos 1.1
*/
float GEOSGeometry::getX() {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    double val;
    if (!GEOSGeomGetX_r(ctx, g->getGeometry(), &val)) {
        if (!check_geos_error(xsink, "GEOS-ERROR", "getX")) {
            xsink->raiseException("GEOS-ERROR", "error getting X coordinate; geometry must be a Point");
        }
        return QoreValue();
    }
    return val;
}

//! Returns the Y coordinate of a point geometry
/** This method only works on Point geometries.

    @return the Y coordinate value

    @throw GEOS-ERROR error getting Y coordinate or geometry is not a point

    @since geos 1.1
*/
float GEOSGeometry::getY() {
    GEOSContextHandle_t ctx = geos_get_context();
    geos_error_msg.clear();
    double val;
