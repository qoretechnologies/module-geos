# Valgrind suppressions for known false positives from optimized libqore
# and libgeos builds. These are uninitialized value reads caused by compiler
# optimizations in release builds - not actual bugs.

# --- libqore false positives (optimized build) ---

{
   qore-value-set-uninit
   Memcheck:Cond
   fun:*QoreValue*set*
}

{
   qore-value-gettype-uninit
   Memcheck:Cond
   fun:*QoreValue*getType*
}

{
   qore-value-assign-uninit
   Memcheck:Cond
   fun:*QoreValue*assign*
}

{
   qore-value-deref-uninit
   Memcheck:Cond
   fun:*QoreValue*deref*
}

{
   qore-value-discard-uninit
   Memcheck:Cond
   fun:*QoreValue*discard*
}

{
   qore-value-isnothing-uninit
   Memcheck:Cond
   fun:*QoreValue*isNothing*
}

{
   qore-value-isnull-uninit
   Memcheck:Cond
   fun:*QoreValue*isNull*
}

{
   qore-parser-yyparse-uninit
   Memcheck:Cond
   fun:*yyparse*
}

{
   qore-parser-process-assignment-uninit
   Memcheck:Cond
   fun:*process_assignment*
}

{
   qore-parser-splice-expressions-uninit
   Memcheck:Cond
   fun:*splice_expressions*
}

{
   qore-init-math-uninit
   Memcheck:Cond
   ...
   fun:*init_math_constants*
}

{
   qore-static-system-ns-uninit
   Memcheck:Cond
   ...
   fun:*StaticSystemNamespace*
}

{
   qore-constant-clear-uninit
   Memcheck:Cond
   ...
   fun:*ConstantList*clear*
}

{
   qore-qorevalue-cond-generic
   Memcheck:Cond
   obj:*/libqore.so*
}

{
   qore-qorevalue-value-generic
   Memcheck:Value8
   obj:*/libqore.so*
}

# --- libgeos false positives ---

{
   geos-strtree-nearest-uninit-1
   Memcheck:Cond
   ...
   obj:*/libgeos_c.so*
   fun:GEOSSTRtree_nearest_generic_r
}

{
   geos-strtree-nearest-uninit-2
   Memcheck:Cond
   fun:GEOSSTRtree_nearest_generic_r
}

# --- PCRE2 JIT-generated code ---
#
# Qore compiles regular expressions with PCRE2's JIT.  The JIT emits code into
# anonymous executable memory, so Valgrind cannot symbolize or unwind through
# it (the frames appear as repeated "???" entries).  Its scanning loops test
# whole words and rely on PCRE2's bounds tracking, which distribution PCRE2
# builds do not annotate for Memcheck.  Keep these entries in sync with the
# canonical PCRE2 JIT suppressions in Qore's qore.supp.
#
# Valgrind can only match unattributable frames as obj:*, so these entries also
# cover other JIT-generated code.  Re-run without this suppression file when
# investigating suspected generated-code defects.

{
   pcre2-jit-generated-code-cond
   Memcheck:Cond
   obj:*
   ...
}

{
   pcre2-jit-generated-code-value8
   Memcheck:Value8
   obj:*
   ...
}
